# Docker Compose interpolation values (copy to .env, which is gitignored).
# Backend application settings live in backend/.env instead.

# Encrypts HR users' own AI provider keys; must match backend/.env.
AI_CREDENTIAL_ENCRYPTION_KEY=

# --- Public test access through ngrok (docker-compose.public.yml) ---
# See docs/operations/PUBLIC_TEST_ACCESS.md. Start with: .\scripts\public.ps1 up
# Authtoken from https://dashboard.ngrok.com (Your Authtoken). Secret.
NGROK_AUTHTOKEN=
# Your ngrok dev domain, bare host without https://, e.g. something.ngrok-free.app
NGROK_DOMAIN=
# Optional: Google OAuth client id for the public CRM build (hidden when empty).
VITE_GOOGLE_CLIENT_ID=
# Optional: local port of the edge proxy (same routing as the public URL).
PUBLIC_EDGE_PORT=8090
