  "panels": [
    {
      "title": "Database Connection Pool Saturation (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "db_pool_checked_out / db_pool_size * 100",
          "legendFormat": "Pool Saturation %"
        }
      ]
    },
    {
      "title": "Active vs Idle Database Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "db_pool_checked_out",
          "legendFormat": "In Use (Checked Out)"
        },
        {
          "datasource": "Prometheus",
          "expr": "db_pool_checked_in",
          "legendFormat": "Idle (Checked In)"
        },
        {
          "datasource": "Prometheus",
          "expr": "db_pool_overflow",
          "legendFormat": "Overflow Active"
        }
      ]
    }
  ],
