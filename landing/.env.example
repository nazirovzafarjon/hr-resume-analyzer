# Resume Analyzer landing environment template.
# Copy this file to `.env.local` (or `.env`) and adjust for your machine.

# Origin of the CRM app (crm/). "Log in" and "Get started" send visitors
# to <VITE_APP_URL>/login and <VITE_APP_URL>/register, where the existing
# authentication pages talk to the backend. Signed-in visitors instead see
# "Open workspace" -> <VITE_APP_URL>/dashboard. No trailing slash.
VITE_APP_URL=http://localhost:5173

# Base URL of the FastAPI backend (same value as the CRM's VITE_API_BASE_URL).
# Used only by the public Contact form (POST /public/contact). The backend's
# BACKEND_CORS_ORIGINS must include this site's origin (http://localhost:5174).
VITE_API_BASE_URL=http://localhost:8000/api

# Public address of this landing site, used for canonical/Open Graph URLs.
# Leave empty in development.
VITE_SITE_URL=

# Optional contact address shown next to the Contact form as a direct mailto
# link. The form itself always posts to the backend; leave empty to hide it.
VITE_CONTACT_EMAIL=
