# Resume Analyzer CRM environment template.
# Copy this file to `.env.local` (or `.env`) and adjust for your machine.
# Never commit real secrets.

# Base URL of the FastAPI backend.
# Matches the backend default API_PREFIX of "/api" (see backend/.env.example).
# The local backend runs with: uvicorn app.main:app --reload  (http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000/api

# Google OAuth 2.0 (Sign in with Google)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# and add VITE_GOOGLE_REDIRECT_URI to the app's "Authorized redirect URIs".
# This must match the backend GOOGLE_REDIRECT_URI exactly.
VITE_GOOGLE_CLIENT_ID=52314646701-93k5tsp9d2bib6d36a3515oatad2mrdp.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# Origin of the public landing site (landing/). The sidebar's "Back to home"
# link goes here; it keeps the user signed in. No trailing slash.
VITE_LANDING_URL=http://localhost:5174

# Cookie domain for the non-secret "signed in" hint the landing site reads to
# show "Open workspace" instead of "Log in". Leave empty when both apps share a
# host (e.g. localhost:5173 + localhost:5174). For sibling subdomains in
# production use the parent domain, e.g. .example.com
VITE_SESSION_COOKIE_DOMAIN=
