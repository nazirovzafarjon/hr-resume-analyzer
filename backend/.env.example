# Application
APP_NAME=Resume Analyzer API
DEBUG=true
API_PREFIX=/api

# Security - always override with a strong random value in production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh tokens outlive access tokens and are only ever presented to
# POST /api/auth/refresh (rotation: each one is single-use).
REFRESH_TOKEN_EXPIRE_DAYS=7
# Lifetime of the token carried by an emailed password-reset link.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Lifetime of the 6-digit email-verification code (required before an HR panel
# can be used).
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=10
# Wrong-code attempts allowed per active code before it is invalidated.
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# Minimum seconds between two verification codes for the same address.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Maximum verification codes that may be issued for one address per hour.
EMAIL_VERIFICATION_MAX_PER_HOUR=5
# Frontend origin used to build the absolute reset link
# (-> <FRONTEND_BASE_URL>/reset-password?token=...). In development the link is
# written to the server log instead of being emailed.
FRONTEND_BASE_URL=http://localhost:5173

# Resend (transactional email - email verification & password reset delivery)
# Get an API key at https://resend.com/api-keys.
#
# EMAIL_FROM MUST be an address on a domain you have verified in Resend
# (Dashboard -> Domains), complete with its SPF/DKIM DNS records. The shared
# sandbox sender onboarding@resend.dev only delivers to the address that owns
# the Resend account and returns HTTP 403 for everyone else.
#
# Production example (verified custom domain):
#   EMAIL_FROM=noreply@edubaselearning.uz
#   EMAIL_FROM_NAME=EduBase
#   EMAIL_REPLY_TO=support@edubaselearning.uz
RESEND_API_KEY=
EMAIL_FROM=noreply@edubaselearning.uz
EMAIL_FROM_NAME=EduBase
# Optional Reply-To; leave empty to fall back to the From address.
EMAIL_REPLY_TO=
# Delivery retry policy: only transient provider failures (HTTP 429/5xx or a
# network error) are retried, with bounded exponential backoff. Permanent 4xx
# rejections (sandbox 403, invalid key) fail immediately.
EMAIL_MAX_RETRIES=2
EMAIL_RETRY_BASE_DELAY=1
EMAIL_MAX_RETRY_WAIT=10
# Seconds to wait for the Resend API (registration sends synchronously).
EMAIL_REQUEST_TIMEOUT=10

# Google OAuth 2.0 (Sign in with Google)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_REDIRECT_URI to the app's "Authorized redirect URIs".
# GOOGLE_REDIRECT_URI is the frontend callback route the browser returns to
# after the Google consent screen; it must match the frontend
# VITE_GOOGLE_REDIRECT_URI exactly.
# Note: authorization codes issued by Google's JS *popup* flow are bound to
# "postmessage" instead of this URL; the backend accepts both automatically.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer
# Apply pending Alembic migrations when the API starts (true), or refuse to
# start on an out-of-date schema and ask for `alembic upgrade head` (false).
DB_AUTO_MIGRATE=true

# CORS - comma-separated browser origins allowed to call this API
# (the CRM on :5173 and the landing site on :5174, which posts its Contact form)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Encrypts the AI provider API keys HR users save in Settings ("Connect your
# provider and API key"). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable custom providers (the platform provider below keeps
# working). Changing it makes already-saved keys unreadable (users re-enter them).
AI_CREDENTIAL_ENCRYPTION_KEY=

# OpenRouter (AI provider for job vacancy analysis)
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=Resume Analyzer
OPENROUTER_MAX_CONTENT_LENGTH=50000

# AI Provider Configuration (general, provider-agnostic).
# These take precedence over provider-specific legacy variables.
# Supported providers: openrouter, groq, gemini
# true: every HR must save their own AI key + model in Settings -> AI provider
# before AI features run for them (the platform key below is not used for HR
# work). false: HRs without their own configuration use the platform key.
REQUIRE_USER_AI_CONFIG=true
AI_PROVIDER=openrouter
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=2
# Longest single provider-requested wait (Retry-After) to honour, in seconds
AI_MAX_RETRY_WAIT=30
# Total seconds one AI call may spend waiting between retries
AI_RETRY_BUDGET=45
AI_REQUEST_TIMEOUT=60
AI_HTTP_REFERER=
AI_APP_TITLE=Resume Analyzer

# Profile images (local storage, served from the /uploads static mount)
# Directory that stores uploaded files (profile images), relative to the
# directory the backend is started from.
UPLOAD_DIR=uploads
# Maximum accepted size for a profile image upload, in megabytes.
PROFILE_IMAGE_MAX_SIZE_MB=5

# Super admin (applied on every backend startup)
# SUPERUSER_EMAIL is always kept an active admin: created if it does not exist,
# promoted/reactivated if it does. SUPERUSER_PASSWORD (min. 8 characters) is
# used when the account is created or has no password yet (Google-only); an
# existing password is never overwritten. Leave SUPERUSER_EMAIL empty to disable.
# Fill these in locally - never commit real credentials.
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-strong-password
SUPERUSER_FULL_NAME=Administrator