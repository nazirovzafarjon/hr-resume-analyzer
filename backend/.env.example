# Application
APP_NAME=Resume Analyzer API
DEBUG=true
API_PREFIX=/api

# Security - always override with a strong random value in production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh tokens outlive access tokens and are only ever presented to
# POST /api/auth/refresh (rotation: each one is single-use).
REFRESH_TOKEN_EXPIRE_DAYS=7
# Lifetime of the token carried by an emailed password-reset link.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Frontend origin used to build the absolute reset link
# (-> <FRONTEND_BASE_URL>/reset-password?token=...). In development the link is
# written to the server log instead of being emailed.
FRONTEND_BASE_URL=http://localhost:5173

# Resend (transactional email - password reset delivery)
# Get an API key at https://resend.com/api-keys. EMAIL_FROM must be a verified
# sender: the onboarding@resend.dev sandbox sender only delivers to the email
# your Resend account was registered with. Leave RESEND_API_KEY empty to keep
# the dev fallback (reset links written to the server log).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Google OAuth 2.0 (Sign in with Google)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_REDIRECT_URI to the app's "Authorized redirect URIs".
# GOOGLE_REDIRECT_URI is the frontend callback route the browser returns to
# after the Google consent screen; it must match the frontend
# VITE_GOOGLE_REDIRECT_URI exactly.
# Note: authorization codes issued by Google's JS *popup* flow are bound to
# "postmessage" instead of this URL; the backend accepts both automatically.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

# CORS - comma-separated browser origins allowed to call this API
# (the CRM on :5173 and the landing site on :5174, which posts its Contact form)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# OpenRouter (AI provider for job vacancy analysis)
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=Resume Analyzer
OPENROUTER_MAX_CONTENT_LENGTH=50000

# AI Provider Configuration (general, provider-agnostic).
# These take precedence over provider-specific legacy variables.
# Supported providers: openrouter, groq, gemini
AI_PROVIDER=openrouter
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=2
AI_REQUEST_TIMEOUT=60
AI_HTTP_REFERER=
AI_APP_TITLE=Resume Analyzer

# Profile images (local storage, served from the /uploads static mount)
# Directory that stores uploaded files (profile images), relative to the
# directory the backend is started from.
UPLOAD_DIR=uploads
# Maximum accepted size for a profile image upload, in megabytes.
PROFILE_IMAGE_MAX_SIZE_MB=5

# Superuser seed (created automatically on startup if no superuser exists yet)
# Needed to use the admin /api/users endpoints (list/read/update/delete users)
# Fill these in locally - never commit real credentials.
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-strong-password
SUPERUSER_FULL_NAME=Administrator